# Facebook login (used by fb_manager for the Messenger sender)
FB_EMAIL=
FB_PASSWORD=

# Facebook Messenger thread to post the report to.
# NOTE: set this to the real Messenger group id. FANTASY_GROUP_ID is NOT a
# Facebook thread anymore (it now holds the FPL league id). fb_sender falls
# back to FAMILY_GROUP_ID if FB_THREAD_ID is unset.
FB_THREAD_ID=
FAMILY_GROUP_ID=

# FPL mini-league id analysed by main_new.py (e.g. 348645 = "Pullman Football
# Samaj", 15 managers). Overridable with `main_new.py --lid <id>`.
FANTASY_GROUP_ID=

# Your own FPL team/entry id (currently informational; not used by the pipeline)
ACHYUT_ID=

# OpenAI key for the "pundit's take" narrative (optional; skipped if absent)
OPENAI_API_KEY=
